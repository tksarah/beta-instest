# Example .env for local development (do NOT commit secrets)

PORT=3000
SQLITE_DB_PATH=

ADMIN_PASSWORD=change_me_admin_password
SESSION_SECRET=change_me_session_secret
STUDENT_SESSION_SECRET=

# Optional: Gemini API key for question generation
GEMINI_API_KEY=
# Optional: override Gemini model
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: local app URL used for cookie and OAuth-related checks
APP_BASE_URL=http://localhost:3000
DOMAIN=localhost

# Optional: Google OAuth settings for local testing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: feedback URL and free beta limits
BETA_FEEDBACK_URL=
FREE_BETA_CLASS_LIMIT=2
FREE_BETA_TEST_LIMIT=3
FREE_BETA_STUDENT_LIMIT=50
FREE_BETA_AI_GENERATION_LIMIT=15

NODE_ENV=development
